{
  "schemaVersion": 1,
  "id": "turenlabs/google-secops",
  "name": "Google Security Operations",
  "description": "Investigate Google SecOps SIEM and SOAR data through Google's hosted Chronicle MCP endpoint",
  "version": "1.0.0",
  "publisher": "Turen Labs",
  "trust": "official",
  "homepage": "https://docs.cloud.google.com/chronicle/docs/secops/use-google-secops-mcp",
  "contributions": [
    {
      "type": "mcp",
      "id": "google-secops",
      "name": "Google Security Operations",
      "description": "Investigate Google SecOps cases, alerts, entities, UDM events, rules, feeds, and SOAR state; case, feed, rule, parser, and action mutations need Allow write tools",
      "adapter": "mcp:google-secops",
      "secrets": [
        {
          "id": "GOOGLE_SECOPS_CLIENT_SECRET",
          "label": "Google OAuth client secret (optional)",
          "required": false
        }
      ],
      "configuration": [
        {
          "id": "clientId",
          "label": "Google OAuth client ID with the Chronicle scope",
          "required": true
        },
        {
          "id": "projectId",
          "label": "Google Cloud project ID billed through x-goog-user-project",
          "required": true
        }
      ],
      "defaultEnabled": false,
      "upstreamPolicy": "static",
      "deployment": { "type": "customer-url", "path": "/mcp", "privateNetwork": false },
      "connection": {
        "oauth": {
          "clientId": "clientId",
          "clientSecret": "GOOGLE_SECOPS_CLIENT_SECRET",
          "scope": "https://www.googleapis.com/auth/chronicle"
        },
        "headers": [{ "name": "x-goog-user-project", "configuration": "projectId" }]
      },
      "authentication": "oauth",
      "localOnly": true,
      "mcpContext": { "maxLoadedTools": 10, "unloadAfterIdleTurns": 3 },
      "tools": {
        "allow": [
          "get_case",
          "list_case_comments",
          "list_cases",
          "update_case",
          "get_case_alert",
          "list_case_alerts",
          "update_case_alert",
          "create_case_comment",
          "execute_bulk_close_case",
          "execute_manual_action",
          "get_connector_event",
          "list_connector_events",
          "create_data_table",
          "add_rows_to_data_table",
          "list_data_tables",
          "list_data_table_rows",
          "delete_data_table_row",
          "generate_threat_detection_opportunity",
          "generate_synthetic_events",
          "evaluate_rule_coverage",
          "evaluate_rule_coverage_long_running",
          "generate_rules",
          "summarize_entity",
          "get_involved_entity",
          "list_involved_entities",
          "search_entity",
          "udm_search",
          "translate_udm_query",
          "search_raw_logs",
          "import_logs",
          "list_feeds",
          "get_feed",
          "enable_feed",
          "disable_feed",
          "delete_feed",
          "create_feed",
          "update_feed",
          "generate_feed_secret",
          "list_integrations",
          "list_integration_actions",
          "list_integration_instances",
          "get_ioc_match",
          "list_playbook_instances",
          "list_playbooks",
          "list_security_alerts",
          "get_security_alert",
          "update_security_alert",
          "get_parser",
          "list_parsers",
          "run_parser",
          "activate_parser",
          "create_parser",
          "deactivate_parser",
          "list_log_types",
          "list_rules",
          "list_rule_errors",
          "get_rule",
          "create_rule",
          "validate_rule",
          "list_rule_detections",
          "get_reference_list",
          "create_reference_list",
          "update_reference_list",
          "get_alert_latest_investigation",
          "get_investigation_by_id",
          "trigger_investigation",
          "execute_actions",
          "get_agent_settings",
          "fetch_alert_data",
          "fetch_enrichment_actions",
          "get_operation"
        ],
        "write": [
          "update_case",
          "update_case_alert",
          "create_case_comment",
          "execute_bulk_close_case",
          "execute_manual_action",
          "create_data_table",
          "add_rows_to_data_table",
          "delete_data_table_row",
          "import_logs",
          "enable_feed",
          "disable_feed",
          "delete_feed",
          "create_feed",
          "update_feed",
          "generate_feed_secret",
          "update_security_alert",
          "run_parser",
          "activate_parser",
          "create_parser",
          "deactivate_parser",
          "create_rule",
          "create_reference_list",
          "update_reference_list",
          "trigger_investigation",
          "execute_actions"
        ]
      },
      "instructions": "Enter the regional Google SecOps MCP origin (for example https://chronicle.us.rep.googleapis.com) and a Google OAuth client ID whose consent screen allows the Chronicle scope. Pass the tenant customer ID, region, and project ID arguments on every call. Keep UDM and raw-log searches bounded; case, feed, rule, parser, and SOAR action mutations stay gated behind Allow write tools."
    }
  ]
}
