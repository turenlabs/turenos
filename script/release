#!/usr/bin/env bash
set -euo pipefail

VERSION=${1:?Usage: ./script/release <version> [--publish-existing]}
VERSION=${VERSION#v}
MODE=${2:-}
if [ "$#" -gt 2 ] || { [ -n "$MODE" ] && [ "$MODE" != --publish-existing ]; }; then
  echo "Usage: ./script/release <version> [--publish-existing]" >&2
  exit 1
fi

# The release source is turenlabs/turenos main; the workflow validates the
# requested version against it. A matching local VERSION file is only a sanity
# check — never a requirement, since this script may run from any checkout.
if [ -f VERSION ]; then
  canonical=$(tr -d '[:space:]' < VERSION)
  if [ "$MODE" != --publish-existing ] && [ "$VERSION" != "$canonical" ]; then
    echo "Warning: requested $VERSION does not match this checkout's VERSION ($canonical)" >&2
    echo "The workflow will fail unless public main carries $VERSION." >&2
  fi
fi

args=(--repo turenio/turen -f version="$VERSION")
if [ "$MODE" = --publish-existing ]; then args+=(-f publish_existing=true); fi
gh workflow run release.yml "${args[@]}"
echo "GitHub Actions now owns the complete release: it builds the public main source privately, signs, publishes the public release, verifies, and updates Homebrew."
