{
  "name": "@turenlabs/desktop",
  "private": true,
  "version": "1.0.30",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/turenlabs/forge",
  "author": {
    "name": "TurenOS",
    "email": "hello@turenlabs.com"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "typecheck": "tsgo -b",
    "predev": "bun ./scripts/predev.ts",
    "dev": "electron-vite dev",
    "prebuild": "bun ./scripts/prebuild.ts",
    "build": "electron-vite build && bun ./scripts/verify-decompile-artifact.ts && bun ./scripts/verify-yara-artifact.ts && bun ./scripts/verify-email-security-artifact.ts && bun ./scripts/verify-wasm-inspect-artifact.ts && bun ./scripts/verify-protocol-inspect-artifact.ts && bun ./scripts/verify-debug-symbols-artifact.ts && bun ./scripts/verify-binwalk-scan-artifact.ts && bun ./scripts/verify-security-extensions-artifact.ts && bun ./scripts/verify-whiteboard-artifact.ts",
    "preview": "electron-vite preview",
    "package": "bun run build && electron-builder --config electron-builder.config.ts",
    "package:dev": "bun run build && electron-builder --mac dir --config electron-builder.config.ts",
    "package:mac": "bun run build && electron-builder --mac --config electron-builder.config.ts",
    "package:win": "bun run build && electron-builder --win --config electron-builder.config.ts",
    "package:linux": "bun run build && electron-builder --linux --config electron-builder.config.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@turenlabs/protocol": "workspace:*",
    "@turenlabs/schema": "workspace:*",
    "@turenlabs/binwalk-scan-wasm": "workspace:*",
    "@turenlabs/debug-symbols-wasm": "workspace:*",
    "@turenlabs/email-authenticate-wasm": "workspace:*",
    "@turenlabs/email-security-wasm": "workspace:*",
    "@turenlabs/ghidra-decompiler-wasm": "workspace:*",
    "@turenlabs/goblin-wasm": "workspace:*",
    "@turenlabs/libpcap-wasm": "workspace:*",
    "@turenlabs/protocol-inspect-wasm": "workspace:*",
    "@turenlabs/rebuild-timeline-wasm": "workspace:*",
    "@turenlabs/static-analysis-wasm": "workspace:*",
    "@turenlabs/static-unpack-wasm": "workspace:*",
    "@turenlabs/stng-core-wasm": "workspace:*",
    "@turenlabs/wasm-inspect-wasm": "workspace:*",
    "@turenlabs/wifi-offline-wasm": "workspace:*",
    "@turenlabs/windows-artifacts-wasm": "workspace:*",
    "@turenlabs/yara-x-wasm": "workspace:*",
    "@zip.js/zip.js": "2.7.62",
    "effect": "catalog:",
    "electron-context-menu": "4.1.2",
    "electron-log": "^5",
    "electron-store": "11.0.2",
    "electron-updater": "6.8.9",
    "electron-window-state": "^5.0.3",
    "marked": "^15",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "optionalDependencies": {
    "@lydell/node-pty-darwin-arm64": "1.2.0-beta.12",
    "@lydell/node-pty-darwin-x64": "1.2.0-beta.12",
    "@lydell/node-pty-linux-arm64": "1.2.0-beta.12",
    "@lydell/node-pty-linux-x64": "1.2.0-beta.12",
    "@lydell/node-pty-win32-arm64": "1.2.0-beta.12",
    "@lydell/node-pty-win32-x64": "1.2.0-beta.12",
    "@parcel/watcher-darwin-arm64": "2.5.1",
    "@parcel/watcher-darwin-x64": "2.5.1",
    "@parcel/watcher-linux-arm64-glibc": "2.5.1",
    "@parcel/watcher-linux-arm64-musl": "2.5.1",
    "@parcel/watcher-linux-x64-glibc": "2.5.1",
    "@parcel/watcher-linux-x64-musl": "2.5.1",
    "@parcel/watcher-win32-arm64": "2.5.1",
    "@parcel/watcher-win32-x64": "2.5.1"
  },
  "devDependencies": {
    "@actions/artifact": "6.2.1",
    "@electron/asar": "3.4.1",
    "@lydell/node-pty": "catalog:",
    "@sentry/solid": "catalog:",
    "@sentry/vite-plugin": "catalog:",
    "@solid-primitives/i18n": "2.2.1",
    "@solid-primitives/storage": "catalog:",
    "@solidjs/meta": "0.29.4",
    "@solidjs/router": "0.15.4",
    "@turenlabs/app": "workspace:*",
    "@turenlabs/ui": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@valibot/to-json-schema": "1.6.0",
    "electron": "42.11.1",
    "electron-builder": "26.15.3",
    "electron-vite": "^5",
    "solid-js": "catalog:",
    "sury": "11.0.0-alpha.4",
    "typescript": "~5.6.2",
    "vite": "catalog:",
    "zod-openapi": "5.4.6"
  }
}
