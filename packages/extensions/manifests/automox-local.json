{
  "schemaVersion": 1,
  "id": "turenlabs/automox-local",
  "name": "Automox",
  "description": "Connect to Automox endpoint posture, compliance, patching, policies, and audit data through the official read-only MCP server",
  "version": "1.0.0",
  "publisher": "Turen Labs",
  "trust": "official",
  "homepage": "https://github.com/AutomoxCommunity/automox-mcp",
  "contributions": [
    {
      "type": "mcp",
      "id": "automox-local",
      "name": "Automox",
      "description": "Official Automox MCP server pinned to read-only mode",
      "instructions": "Enter an org-scoped Automox API key, account UUID, and organization ID. TurenOS downloads the pinned runtime and starts it in read-only mode.",
      "adapter": "mcp:automox-local",
      "secrets": [
        { "id": "AUTOMOX_API_KEY", "label": "Automox API key", "required": true },
        { "id": "AUTOMOX_ACCOUNT_UUID", "label": "Automox account UUID", "required": true }
      ],
      "configuration": [{ "id": "organizationId", "label": "Automox organization ID", "required": true }],
      "defaultEnabled": false,
      "authentication": "key",
      "upstreamPolicy": "static",
      "localOnly": true,
      "deployment": {
        "type": "local",
        "command": "uvx",
        "platforms": ["darwin", "linux", "win32"]
      },
      "tools": {
        "allow": [
          "advanced_device_search",
          "audit_events_ocsf",
          "audit_trail_user_activity",
          "check_group_exclusion_status",
          "check_window_active",
          "device_detail",
          "device_health_metrics",
          "device_search_typeahead",
          "devices_needing_attention",
          "discover_capabilities",
          "get_account",
          "get_account_user",
          "get_action_set_detail",
          "get_action_set_issues",
          "get_action_set_solutions",
          "get_cached_search_results",
          "get_compliance_snapshot",
          "get_data_extract",
          "get_device_assignments",
          "get_device_by_uuid",
          "get_device_full_profile",
          "get_device_inventory",
          "get_device_inventory_categories",
          "get_device_metadata_fields",
          "get_device_scheduled_windows",
          "get_group_scheduled_windows",
          "get_patch_tuesday_readiness",
          "get_policy_window",
          "get_saved_search",
          "get_saved_search_results",
          "get_search_scopes",
          "get_searchable_fields",
          "get_server_group",
          "get_upload_formats",
          "get_user",
          "get_user_api_key",
          "get_webhook",
          "get_worklet_detail",
          "get_zone",
          "list_account_rbac_roles",
          "list_data_extracts",
          "list_device_packages",
          "list_devices",
          "list_devices_for_policies",
          "list_events",
          "list_global_api_keys",
          "list_org_api_keys",
          "list_organizations",
          "list_remediation_action_sets",
          "list_saved_searches",
          "list_searches_for_device",
          "list_server_groups",
          "list_user_api_keys",
          "list_users",
          "list_webhook_deliveries",
          "list_webhook_event_types",
          "list_webhooks",
          "list_zone_users",
          "list_zones",
          "list_zones_for_user",
          "noncompliant_report",
          "patch_approvals_summary",
          "policy_catalog",
          "policy_compliance_stats",
          "policy_detail",
          "policy_execution_counts",
          "policy_execution_timeline",
          "policy_health_overview",
          "policy_history_detail",
          "policy_run_count",
          "policy_run_detail_v2",
          "policy_run_results",
          "policy_runs_by_policy",
          "policy_runs_for_policy",
          "policy_runs_v2",
          "prepatch_report",
          "preview_policy_device_filters",
          "run_saved_search",
          "search_devices",
          "search_org_packages",
          "search_policy_windows",
          "search_worklet_catalog",
          "splashtop_device_status",
          "splashtop_get_attended_access",
          "splashtop_session_status"
        ],
        "write": []
      }
    }
  ]
}
