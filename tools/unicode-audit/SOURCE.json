{
  "crate": "turen-unicode-audit-wasm",
  "upstream": [
    "https://github.com/hsivonen/chardetng",
    "https://github.com/hsivonen/encoding_rs",
    "https://github.com/unicode-rs/unicode-normalization",
    "https://github.com/unicode-rs/unicode-script"
  ],
  "upstreamVersion": "chardetng 1.0.0, encoding_rs 0.8.41, unicode-normalization 0.1.25, unicode-script 0.5.8",
  "derivation": "Bounded wasm-bindgen wrapper around pinned crates.io releases: chardetng performs legacy-encoding guessing, encoding_rs performs WHATWG decode/transcode, unicode-normalization performs NFC/NFD/NFKC/NFKD normalization, and unicode-script provides per-character Script properties for mixed-script identifier detection. BOM handling and the BOM-less UTF-16 heuristic live in this wrapper because chardetng never guesses UTF-16 by design.",
  "license": "MIT OR Apache-2.0",
  "rust": "1.97.1",
  "wasmPack": "0.15.0",
  "wasmBindgen": true,
  "runtimeDependencies": [
    "chardetng 1.0.0 (Apache-2.0 OR MIT)",
    "encoding_rs 0.8.41 ((Apache-2.0 OR MIT) AND BSD-3-Clause)",
    "unicode-normalization 0.1.25 (MIT OR Apache-2.0)",
    "unicode-script 0.5.8 (MIT OR Apache-2.0)",
    "serde 1.0.228 (MIT OR Apache-2.0)",
    "serde_json 1.0.145 (MIT OR Apache-2.0)",
    "wasm-bindgen 0.2.108 (MIT OR Apache-2.0)"
  ],
  "network": false,
  "filesystem": false,
  "executesInput": false,
  "extractsInput": false,
  "decompressesInput": false,
  "limits": {
    "inputBytes": 33554432,
    "optionsBytes": 4096,
    "outputBytes": 4194304,
    "findingsMaximum": 4096,
    "decodedTextBytes": 8388608,
    "findingContextBytes": 128,
    "scriptHistogramBuckets": 64
  }
}
