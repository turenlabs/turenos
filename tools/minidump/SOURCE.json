{
  "crate": "turen-minidump-wasm",
  "upstream": "https://github.com/rust-minidump/rust-minidump",
  "upstreamVersion": "0.27.0",
  "derivation": "Bounded wasm-bindgen wrapper around the pinned minidump and minidump-common crates; HandleDataStream and ThreadNamesStream are decoded by bounds-checked manual decoders and hostile UTF-16 string RVAs are neutralized before parsing for wasm32 usize-safety.",
  "license": "Apache-2.0 OR MIT",
  "rust": "1.97.1",
  "wasmBindgen": true,
  "runtimeDependencies": ["minidump 0.27.0", "minidump-common 0.27.0"],
  "network": false,
  "filesystem": false,
  "executesInput": false,
  "extractsInput": false,
  "decompressesInput": false,
  "limits": {
    "inputBytes": 33554432,
    "optionsBytes": 4096,
    "outputBytes": 4194304,
    "streamDirectoryEntries": 4096,
    "listItems": 4096,
    "streamPreviewBytes": 65536,
    "memoryReadBytes": 65536,
    "handleChainNodes": 64,
    "annotations": 512,
    "stringChars": 4096
  }
}
