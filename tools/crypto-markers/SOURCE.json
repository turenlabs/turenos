  "wasmBindgen": true,
  "runtimeDependencies": [
    "serde 1.0.229 (MIT OR Apache-2.0)",
    "serde_json 1.0.151 (MIT OR Apache-2.0)",
    "wasm-bindgen 0.2.127 (MIT OR Apache-2.0)"
