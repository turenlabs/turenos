{
  "crate": "turen-macos-artifacts-wasm",
  "upstream": "https://github.com/mandiant/macos-UnifiedLogs",
  "upstreamVersion": "0.6.0",
  "derivation": "Turen wrapper exposing four bounded byte-only artifact operations. plist and flate2 are used unmodified from crates.io; macos-unifiedlogs 0.6.0 (Mandiant, Apache-2.0) supplies tracev3 header/catalog/chunkset parsing and firehose entry reconstruction against an empty FileProvider. The FSEvents disk-log and .DS_Store decoders are original Turen implementations; no crates.io FSEvents parser exists.",
  "license": "Apache-2.0 OR MIT",
  "rust": "1.97.1",
  "wasmPack": "0.15.0",
  "wasmBindgen": true,
  "runtimeDependencies": [
    { "crate": "macos-unifiedlogs", "version": "0.6.0", "license": "Apache-2.0" },
    { "crate": "plist", "version": "1.10.1", "license": "MIT" },
    { "crate": "flate2", "version": "1.1.10", "license": "MIT OR Apache-2.0" },
    { "crate": "sha2", "version": "0.10.9", "license": "MIT OR Apache-2.0" },
    { "crate": "serde", "version": "1.0.228", "license": "MIT OR Apache-2.0" },
    { "crate": "serde_json", "version": "1.0.151", "license": "MIT OR Apache-2.0" },
    { "crate": "wasm-bindgen", "version": "0.2.108", "license": "MIT OR Apache-2.0" }
  ],
  "network": false,
  "filesystem": false,
  "executesInput": false,
  "extractsInput": false,
  "decompressesInput": true,
  "limits": {
    "inputBytes": 33554432,
    "optionsBytes": 4096,
    "outputBytes": 4194304,
    "resultsMaximum": 4096,
    "resultsDefault": 256,
    "decompressedBytes": 67108864,
    "plistDepth": 32,
    "plistItems": 4096,
    "plistEvents": 4194304,
    "stringChars": 1024,
    "pathChars": 4096,
    "dsStoreBlocks": 4096,
    "dsStoreDepth": 4,
    "previewBytes": 32,
    "warnings": 64
  }
}
