{
  "crate": "turen-json-query-wasm",
  "upstream": "https://github.com/01mf02/jaq",
  "upstreamVersion": "jaq-core 3.1.1, jaq-json 2.0.3, jaq-std 3.0.3",
  "derivation": "Bounded WebAssembly wrapper around the jaq library crates; upstream CLI, module loading, filesystem, environment, and clock access are not exposed and the env and now filters are removed at compile time.",
  "license": "MIT OR Apache-2.0",
  "rust": "1.97.1",
  "wasmPack": "0.15.0",
  "wasmBindgen": true,
  "runtimeDependencies": [
    "jaq-core 3.1.1 (MIT)",
    "jaq-json 2.0.3 (MIT)",
    "jaq-std 3.0.3 (MIT)",
    "hifijson 0.5.0 (MIT)",
    "serde_json 1.0.151 (MIT OR Apache-2.0)"
  ],
  "network": false,
  "filesystem": false,
  "executesInput": false,
  "extractsInput": false,
  "decompressesInput": false,
  "limits": {
    "inputBytes": 33554432,
    "optionsBytes": 65536,
    "inputDepth": 512,
    "resultsMaximum": 4096,
    "slurpValues": 1048576,
    "outputBytes": 4194304,
    "hostWallClockSeconds": 60
  }
}
